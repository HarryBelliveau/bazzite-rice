[
    {
        "include": ["~/.config/waybar/modules.jsonc"],
        "name": "primary",
        "output": "DP-1"
    },
    {
        "include": ["~/.config/waybar/modules.jsonc"],
        "name": "secondary",
        "output": "DP-2",

        "hyprland/workspaces": {
            "format": "⌘{name}",
            "all-outputs": false,
            "show-special": false,
            "persistent-workspaces": {},
            "on-click": "activate"
        }
    }
]
