configuration {
    modes:                      "drun,run,window";
    show-icons:                 true;
    drun-display-format:        "{name}";
    display-drun:               "Apps";
    display-run:                "Run";
    display-window:             "Windows";
    font:                       "JetBrainsMono Nerd Font 11";
    icon-theme:                 "Papirus-Dark";
    terminal:                   "kitty";
}

/* Catppuccin Mocha */
* {
    bg:         #1e1e2e;
    bg-alt:     #313244;
    fg:         #cdd6f4;
    fg-alt:     #a6adc8;
    blue:       #89b4fa;
    mauve:      #cba6f7;
    red:        #f38ba8;

    background-color:           transparent;
    text-color:                 @fg;
}

window {
    background-color:           @bg;
    border:                     2px;
    border-color:               @blue;
    border-radius:              14px;
    padding:                    18px;
    width:                      640px;
}

mainbox {
    children:                   [ inputbar, listview ];
    spacing:                    14px;
}

inputbar {
    background-color:           @bg-alt;
    border-radius:              10px;
    padding:                    10px 14px;
    children:                   [ prompt, entry ];
}

prompt {
    text-color:                 @mauve;
    padding:                    0 10px 0 0;
}

entry {
    placeholder:                "search...";
    placeholder-color:          @fg-alt;
}

listview {
    lines:                      8;
    scrollbar:                  false;
    spacing:                    4px;
}

element {
    padding:                    8px 12px;
    border-radius:              10px;
    spacing:                    10px;
}

element-icon {
    size:                       1.2em;
}

element selected {
    background-color:           @bg-alt;
    text-color:                 @blue;
}

element-text, element-icon {
    background-color:           inherit;
    text-color:                 inherit;
}
